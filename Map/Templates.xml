<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
	<Frame name="EmberpathCampPinTemplate" mixin="EmberpathCampPinMixin" enableMouse="true" virtual="true">
		<Size x="18" y="18"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<Texture parentKey="Omen" hidden="true">
					<Size x="10" y="10"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="4" y="-4"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Tale" file="Interface\Icons\INV_Misc_Note_01" hidden="true">
					<Size x="9" y="9"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="4" y="4"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>

	<Frame name="EmberpathFriendPinTemplate" mixin="EmberpathFriendPinMixin" enableMouse="true" virtual="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" file="Interface\Icons\Spell_Fire_Fire" alpha="0.5" hidden="true">
					<Size x="22" y="22"/>
					<Anchors>
						<Anchor point="CENTER"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Frame>
</Ui>
